# Variables serveur à configurer dans Vercel. Ne jamais committer leurs valeurs.
AIRTABLE_TOKEN=
CRON_SECRET=
LEMON_SQUEEZY_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Accès admin aux écrans /admin/* ; ne jamais exposer le mot de passe dans Airtable.
HIBOU_ADMIN_USER=hibou
HIBOU_ADMIN_PASSWORD=

# Accès machine au control plane social (Pipedream/agent). S'il est vide, CRON_SECRET sert de secours.
HIBOU_CONTROL_PLANE_SECRET=

# Agent autonome — les valeurs ci-dessous sont des réglages, jamais des secrets.
AI_ENABLED=true
HIBOU_AI_KILL_SWITCH=false
HIBOU_MODEL_LUNA=gpt-5.6-luna
HIBOU_MODEL_TERRA=gpt-5.6-terra
HIBOU_MODEL_SOL=gpt-5.6-sol
HIBOU_MODEL_ASTRA=gpt-6-astra
HIBOU_ALLOW_TERRA=true
HIBOU_ALLOW_SOL=true
HIBOU_ALLOW_ASTRA=true
HIBOU_MAX_ESCALATIONS=2
HIBOU_MAX_API_RETRIES=1
HIBOU_MAX_AI_CALLS_PER_JOB=4
HIBOU_MAX_OUTPUT_TOKENS=900
HIBOU_MAX_COST_PER_JOB_USD=0.10
HIBOU_DAILY_SOFT_BUDGET_USD=0.50
HIBOU_DAILY_HARD_BUDGET_USD=1.00

# Ces Jobs restent visibles dans Airtable mais ne sont jamais réclamés par le scheduler.
HIBOU_RESERVED_JOB_IDS=hibou-site-finalisation-20260913-1317,hibou-video-launch-20260913-1317

# Origine canonique utilisée par /api/wake et les callbacks OAuth sociaux.
HIBOU_PUBLIC_BASE_URL=https://le-hibou-ruse-site.vercel.app

# Facultatif : prompt OpenAI enregistré. Sans ID, HIBOU_AGENT_V1 versionné dans le dépôt est utilisé.
HIBOU_OPENAI_PROMPT_ID=
HIBOU_OPENAI_PROMPT_VERSION=

# Social direct API / OAuth (names only; never commit real values)
HIBOU_SOCIAL_VAULT_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_SCOPES=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_OAUTH_SCOPES=
META_TARGET_PAGE_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_SCOPES=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_SCOPES=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_OAUTH_SCOPES=
PINTEREST_BOARD_ID=
PINTEREST_SANDBOX=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=
LINKEDIN_ORGANIZATION_URN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_SCOPES=

# Fallback webhook / Pipedream optionnel. Le direct officiel reste prioritaire.
# Un même secret bearer peut protéger les workflows Pipedream si utilisé.
HIBOU_SOCIAL_WEBHOOK_SECRET=
HIBOU_SOCIAL_YOUTUBE_WEBHOOK_URL=
HIBOU_SOCIAL_INSTAGRAM_WEBHOOK_URL=
HIBOU_SOCIAL_FACEBOOK_WEBHOOK_URL=
HIBOU_SOCIAL_TIKTOK_WEBHOOK_URL=
HIBOU_SOCIAL_LINKEDIN_WEBHOOK_URL=
HIBOU_SOCIAL_PINTEREST_WEBHOOK_URL=
HIBOU_SOCIAL_X_WEBHOOK_URL=
HIBOU_SOCIAL_THREADS_WEBHOOK_URL=
HIBOU_SOCIAL_SNAPCHAT_WEBHOOK_URL=
