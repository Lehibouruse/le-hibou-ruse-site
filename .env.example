# Variables serveur à configurer dans Vercel. Ne jamais committer leurs valeurs.
AIRTABLE_TOKEN=
CRON_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Commerce — Lemon Squeezy. Valeurs secrètes uniquement dans Vercel.
LEMON_SQUEEZY_API_KEY=
# Clé distincte créée depuis le mode Test Lemon. Obligatoire pour checkout_test/webhook_test.
# Ne jamais réutiliser la clé Live ici.
LEMON_SQUEEZY_TEST_API_KEY=
# Optionnel si CRON_SECRET est déjà configuré : le runtime dérive alors un secret Lemon
# distinct par HMAC (jamais exposé). Une valeur explicite ici reste prioritaire.
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Commerce — Digify.
# SEULES variables humaines obligatoires pour commencer : Key ID + Secret créés dans le Developer Portal Digify.
DIGIFY_KEY_ID=
DIGIFY_SECRET=
# L'ajout destinataire utilise par défaut l'endpoint officiel actuel :
# https://api.digify.com/v1/file/recipient/add
# Garder cette variable vide sauf nécessité de surcharge après vérification de la documentation officielle.
DIGIFY_ADD_RECIPIENT_URL=
# Le payload exact reste volontairement vide jusqu'à capture du schéma officiel du Developer Portal.
DIGIFY_ADD_RECIPIENT_BODY_TEMPLATE=
# La révocation reste désactivée tant que l'endpoint et le payload officiels ne sont pas confirmés.
DIGIFY_REVOKE_RECIPIENT_URL=
DIGIFY_REVOKE_RECIPIENT_BODY_TEMPLATE=
# Auth Basic de /api/commerce/digify-webhook : optionnelle si CRON_SECRET existe.
# Par défaut le runtime dérive automatiquement un couple dédié sans exposer CRON_SECRET.
DIGIFY_WEBHOOK_USERNAME=
DIGIFY_WEBHOOK_PASSWORD=

# Accès admin aux écrans /admin/* ; ne jamais exposer le mot de passe dans Airtable.
HIBOU_ADMIN_USER=hibou
HIBOU_ADMIN_PASSWORD=

# Accès machine au control plane social (Pipedream/agent). S'il est vide, CRON_SECRET sert de secours.
HIBOU_CONTROL_PLANE_SECRET=

# Agent autonome — les valeurs ci-dessous sont des réglages, jamais des secrets.
AI_ENABLED=false
HIBOU_AI_KILL_SWITCH=true
HIBOU_MODEL_LUNA=gpt-5.6-luna
HIBOU_MODEL_TERRA=gpt-5.6-terra
HIBOU_MODEL_SOL=gpt-5.6-sol
HIBOU_MODEL_ASTRA=gpt-6-astra
HIBOU_ALLOW_TERRA=false
HIBOU_ALLOW_SOL=false
HIBOU_ALLOW_ASTRA=false
HIBOU_MAX_ESCALATIONS=2
HIBOU_MAX_API_RETRIES=0
HIBOU_MAX_AI_CALLS_PER_JOB=0
HIBOU_MAX_OUTPUT_TOKENS=900
HIBOU_MAX_COST_PER_JOB_USD=0
HIBOU_DAILY_SOFT_BUDGET_USD=0
HIBOU_DAILY_HARD_BUDGET_USD=0

# Ces Jobs restent visibles dans Airtable mais ne sont jamais réclamés par le scheduler.
HIBOU_RESERVED_JOB_IDS=hibou-site-finalisation-20260913-1317,hibou-video-launch-20260913-1317

# Origine publique utilisée tant que le domaine de marque n'est pas vérifié.
# IMPORTANT SEO : ne pas remplacer par d4d5d6.com avant validation DNS + Vercel.
HIBOU_PUBLIC_BASE_URL=https://le-hibou-ruse-site.vercel.app
HIBOU_CANONICAL_HOST=d4d5d6.com
HIBOU_CANONICAL_DOMAIN_VERIFIED=false
# N'activer la redirection Vercel -> domaine de marque qu'une fois le domaine réellement vérifié.
HIBOU_CANONICAL_REDIRECT_ENABLED=false

# Facultatif : prompt OpenAI enregistré. Sans ID, HIBOU_AGENT_V1 versionné dans le dépôt est utilisé.
HIBOU_OPENAI_PROMPT_ID=
HIBOU_OPENAI_PROMPT_VERSION=

# Social direct API / OAuth (noms uniquement; ne jamais committer les vraies valeurs secrètes)
HIBOU_SOCIAL_VAULT_KEY=

# YouTube / Google
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly
YOUTUBE_ANALYTICS_LOOKBACK_DAYS=365

# Meta / Facebook Pages
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_OAUTH_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,read_insights,instagram_basic,instagram_content_publish,instagram_manage_insights
META_TARGET_PAGE_ID=

# Instagram Business Login — flux distinct de Facebook Login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.publish,video.upload
TIKTOK_APP_AUDITED=false
TIKTOK_TRANSFER_MODE=FILE_UPLOAD

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_SCOPES=threads_basic,threads_content_publish,threads_manage_insights
THREADS_REFRESH_URL=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_OAUTH_SCOPES=boards:read,boards:write,pins:read,pins:write,user_accounts:read
PINTEREST_BOARD_ID=
PINTEREST_SANDBOX=true

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Le Hibou cible l'organisation : w_organization_social pour publier ;
# rw_organization_admin pour les statistiques de Page/publications, soumis à l'accès Community Management et au rôle ADMINISTRATOR.
# w_member_social est conservé pour permettre une voie profil si nécessaire.
LINKEDIN_OAUTH_SCOPES=openid profile w_member_social w_organization_social r_organization_social rw_organization_admin
LINKEDIN_ORGANIZATION_URN=urn:li:organization:146337938
LINKEDIN_VERSION=202608

# X — aucune activation payante/dépense sans validation humaine explicite
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access media.write
X_TOKEN_URL=

# Modes par réseau : auto | direct | webhook. auto privilégie le direct quand les credentials sont disponibles.
HIBOU_SOCIAL_YOUTUBE_MODE=auto
HIBOU_SOCIAL_INSTAGRAM_MODE=auto
HIBOU_SOCIAL_FACEBOOK_MODE=auto
HIBOU_SOCIAL_TIKTOK_MODE=auto
HIBOU_SOCIAL_LINKEDIN_MODE=auto
HIBOU_SOCIAL_PINTEREST_MODE=auto
HIBOU_SOCIAL_X_MODE=auto
HIBOU_SOCIAL_THREADS_MODE=auto
HIBOU_SOCIAL_SNAPCHAT_MODE=auto

# Fallback webhook / Pipedream optionnel. Le direct officiel reste prioritaire.
# Un même secret bearer peut protéger les workflows Pipedream si utilisé.
HIBOU_SOCIAL_WEBHOOK_SECRET=
HIBOU_SOCIAL_YOUTUBE_WEBHOOK_URL=
HIBOU_SOCIAL_INSTAGRAM_WEBHOOK_URL=
HIBOU_SOCIAL_FACEBOOK_WEBHOOK_URL=
HIBOU_SOCIAL_TIKTOK_WEBHOOK_URL=
HIBOU_SOCIAL_LINKEDIN_WEBHOOK_URL=
HIBOU_SOCIAL_PINTEREST_WEBHOOK_URL=
HIBOU_SOCIAL_X_WEBHOOK_URL=
HIBOU_SOCIAL_THREADS_WEBHOOK_URL=
HIBOU_SOCIAL_SNAPCHAT_WEBHOOK_URL=
