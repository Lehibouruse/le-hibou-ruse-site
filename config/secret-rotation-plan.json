{
  "schema": "HIBOU_SECRET_ROTATION_PLAN_V1",
  "groups": [
    {
      "id": "airtable",
      "secrets": ["AIRTABLE_TOKEN"],
      "consumers": ["local backup scripts", "local worker advanced mode", "selected server-side Airtable calls"],
      "validation": ["read safe table", "write/delete only in a dedicated test record if explicitly authorized"],
      "priority": "P0_if_compromised"
    },
    {
      "id": "commerce_test",
      "secrets": ["LEMON_SQUEEZY_TEST_API_KEY"],
      "consumers": ["Vercel TEST commerce bootstrap"],
      "validation": ["TEST preflight", "TEST inspect", "TEST checkout", "TEST webhook"],
      "priority": "P1"
    },
    {
      "id": "commerce_live",
      "secrets": ["LEMON_SQUEEZY_API_KEY", "LEMON_SQUEEZY_WEBHOOK_SECRET"],
      "consumers": ["Vercel LIVE commerce"],
      "validation": ["readiness only", "signed webhook test", "no live purchase during rehearsal"],
      "priority": "P0_if_compromised"
    },
    {
      "id": "service_auth",
      "secrets": ["HIBOU_SERVICE_TOKEN", "ADMIN_USERNAME", "ADMIN_PASSWORD", "BOOK_PREVIEW_PASSWORD"],
      "consumers": ["admin/service/book-preview routes"],
      "validation": ["old credential rejected after cutover", "new credential accepted on protected read-only probe"],
      "priority": "P0_if_compromised"
    },
    {
      "id": "social_vault",
      "secrets": ["HIBOU_SOCIAL_VAULT_KEY"],
      "consumers": ["encrypted social credential vault"],
      "validation": ["decrypt known test credential before rotation", "re-encrypt test credential with new key", "old key rejected after migration"],
      "priority": "P0_if_compromised",
      "special_warning": "Do not rotate without a tested credential re-encryption/migration procedure."
    },
    {
      "id": "social_provider_clients",
      "secrets": ["*_CLIENT_SECRET", "*_APP_SECRET", "*_ACCESS_TOKEN", "*_REFRESH_TOKEN"],
      "consumers": ["provider-specific OAuth/runtime connectors"],
      "validation": ["provider identity/read probe only", "no publication during rehearsal"],
      "priority": "provider_specific"
    }
  ],
  "policy": {
    "never_print_secret_values": true,
    "never_store_secret_values_in_airtable": true,
    "never_store_secret_values_in_git": true,
    "default_network_access": false,
    "default_external_mutation": false,
    "rehearsal_is_dry_run": true
  }
}
