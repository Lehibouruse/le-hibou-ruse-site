{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d4d5d6.com/schemas/hibou-video-contract-v1.json",
  "title": "Le Hibou Rusé video production contract",
  "type": "object",
  "required": [
    "contract_version",
    "content",
    "engine",
    "scenes",
    "audio",
    "music",
    "subtitles",
    "qc",
    "validation"
  ],
  "properties": {
    "contract_version": {
      "const": "HIBOU_VIDEO_CONTRACT_V1"
    },
    "content": {
      "type": "object",
      "required": [
        "content_id",
        "script_version",
        "profile_version",
        "method_version"
      ],
      "properties": {
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "script_version": {
          "type": [
            "string",
            "number"
          ]
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "renderer",
        "renderer_version",
        "fps",
        "width",
        "height"
      ],
      "properties": {
        "renderer": {
          "type": "string"
        },
        "renderer_version": {
          "type": "string"
        },
        "fps": {
          "const": 30
        },
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "preset": {
          "type": "string"
        },
        "crf": {
          "type": "number",
          "minimum": 14,
          "maximum": 24
        },
        "preview_preset": {
          "type": "string"
        },
        "preview_crf": {
          "type": "number",
          "minimum": 18,
          "maximum": 30
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "order",
          "narration_exact",
          "visual_idea",
          "screen_text",
          "planned_duration_s",
          "image",
          "breath_unit",
          "voice"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "narration_exact": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "mode",
                  "source_audio",
                  "start_s",
                  "end_s",
                  "sha256"
                ],
                "properties": {
                  "mode": {
                    "const": "audio_reference"
                  },
                  "source_audio": {
                    "type": "string"
                  },
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "text",
                  "script_sha256"
                ],
                "properties": {
                  "mode": {
                    "const": "text_reference"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "script_sha256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  }
                }
              }
            ]
          },
          "visual_idea": {
            "type": "string"
          },
          "screen_text": {
            "type": "string"
          },
          "planned_duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "measured_duration_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "zoom_percent": {
            "type": "number",
            "minimum": 2,
            "maximum": 4
          },
          "image": {
            "type": "object",
            "required": [
              "candidates",
              "selected",
              "selection_reason"
            ],
            "properties": {
              "candidates": {
                "type": "array"
              },
              "selected": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "selection_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "breath_unit": {
            "type": "string"
          },
          "voice": {
            "type": "object",
            "required": [
              "target_wpm",
              "relative_speed_pct",
              "pause_after_ms",
              "emphasis",
              "intent"
            ],
            "properties": {
              "target_wpm": {
                "type": "number"
              },
              "relative_speed_pct": {
                "type": "number"
              },
              "pause_after_ms": {
                "type": "number",
                "minimum": 0
              },
              "emphasis": {
                "type": "string"
              },
              "intent": {
                "type": "string"
              },
              "verbatim": {
                "type": "boolean"
              },
              "prosody_cues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "phrase": {
                      "type": "string"
                    },
                    "pause_before_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "pause_after_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "relative_speed_pct": {
                      "type": "number",
                      "minimum": 85,
                      "maximum": 115
                    },
                    "emphasis": {
                      "type": "string"
                    },
                    "intent": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "timeline": {
            "$ref": "./video-scene-timeline-v1.schema.json"
          },
          "pose_request": {
            "type": "string"
          },
          "visual_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "asset_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slot",
                "kind"
              ],
              "properties": {
                "slot": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "required_tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "optional_tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scene_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "motion_mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "STATIC_SCENE",
              "ANIMATED_SCENE",
              null
            ]
          },
          "persona_case": {
            "type": [
              "string",
              "null"
            ]
          },
          "qualify": {
            "type": [
              "string",
              "null"
            ]
          },
          "disqualify": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "risk": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "jurisdiction": {
            "type": [
              "string",
              "null"
            ]
          },
          "as_of_date": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "audio": {
      "type": "object"
    },
    "music": {
      "type": "object"
    },
    "subtitles": {
      "type": "object"
    },
    "qc": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "contract_state": {
      "type": "string",
      "enum": [
        "storyboard",
        "render_ready",
        "rendered"
      ]
    },
    "features": {
      "type": "object",
      "properties": {
        "video_timeline_v1": {
          "type": "boolean"
        },
        "video_creative_qc_v1": {
          "type": "boolean"
        },
        "video_pose_registry_v1": {
          "type": "boolean"
        },
        "video_prosody_v1": {
          "type": "boolean"
        },
        "video_music_mix_v1": {
          "type": "boolean"
        },
        "video_incremental_retouch_v1": {
          "type": "boolean"
        },
        "video_human_candidate_selection_v1": {
          "type": "boolean"
        },
        "video_prompt_graph_v1": {
          "type": "boolean"
        },
        "video_planning_audit_v1": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "production": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "preview",
            "final"
          ]
        },
        "candidates_per_scene": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "preview_candidates_per_scene": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "final_candidates_per_scene": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "additionalProperties": true
    }
  }
}
