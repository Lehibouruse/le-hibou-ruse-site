{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d4d5d6.com/schemas/video-contract-v1.json",
  "title": "Le Hibou Rusé Video Contract V1",
  "type": "object",
  "required": ["contract_version","content","source","output","voice","music_cues","subtitles","scenes","validation"],
  "properties": {
    "contract_version": {"const":"VIDEO_CONTRACT_V1"},
    "content": {"type":"object","required":["content_id","content_version","script_version","profile_id","profile_version","method_id","renderer_id","status"]},
    "source": {"type":"object","required":["reference_file","reference_sha256","reference_role"]},
    "output": {"type":"object","required":["width","height","fps","video_codec","audio_codec","pixel_format","container","faststart","music_policy","target"]},
    "voice": {"type":"object","required":["mode","engine","reference_audio","reference_audio_sha256","tts_regeneration_allowed","note"]},
    "music_cues":{"type":"array"},
    "subtitles":{"type":"object"},
    "scenes":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["scene_id","order","narration_exact","visual_idea","onscreen_text","planned_duration_s","measured_duration_s","image_generation","selected_image","selection_reason","image_params","prosody","audio_ref","music_cues","subtitles","qc"],
      "properties":{
        "scene_id":{"type":"string","minLength":1},"order":{"type":"integer","minimum":1},
        "narration_exact":{"type":"object","oneOf":[
          {"required":["mode","text"],"properties":{"mode":{"const":"text"},"text":{"type":"string","minLength":1}}},
          {"required":["mode","audio_ref","start_s","end_s"],"properties":{"mode":{"const":"locked_audio_slice"},"audio_ref":{"type":"string"},"start_s":{"type":"number","minimum":0},"end_s":{"type":"number","exclusiveMinimum":0}}}
        ]},
        "planned_duration_s":{"type":"number","exclusiveMinimum":0},"measured_duration_s":{"type":"number","exclusiveMinimum":0},
        "selected_image":{"type":"string"},"audio_ref":{"type":"string"}
      }
    }},
    "validation":{"type":"object"}
  }
}
