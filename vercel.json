{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    },
    "ignoreCommand": "git diff HEAD^ HEAD --quiet -- app components lib public package.json package-lock.json proxy.js vercel.json"
  },
  "crons": [
    {
      "path": "/api/health",
      "schedule": "37 5 * * *"
    },
    {
      "path": "/api/domain-reconcile",
      "schedule": "53 5 * * *"
    }
  ],
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- app components public package.json package-lock.json proxy.js vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
